# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:12345678@localhost:5432/unitrack

# JWT Secrets (min 32 chars in production)
JWT_ACCESS_SECRET=your-access-token-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-token-secret-min-32-chars-long

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@unitrack.app

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your-expo-access-token

# Server & Application Configuration
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
NODE_ENV=development
PORT=3000
